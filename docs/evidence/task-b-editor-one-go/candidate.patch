+@click.command("config", short_help="Show the app's config as JSON.")
+@with_appcontext
+def config_command() -> None:
+    """Show the application's configuration as JSON.
+
+    The values of any key whose name contains ``SECRET``, ``PASSWORD``,
+    ``TOKEN``, or ``KEY`` are masked as ``"***"`` so that sensitive
+    values are not displayed.
+    """
+    config = current_app.config.copy()
+
+    for key in config:
+        if any(s in key.upper() for s in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            config[key] = "***"
+
+    click.echo(json.dumps(config, indent=2, default=str))
+
