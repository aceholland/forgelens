+def test_config_command(runner):
+    app = Flask(__name__)
+    app.config["SECRET_KEY"] = "sensitive"
+    app.config["CUSTOM_TOKEN"] = "sensitive"
+    app.config["MY_PASSWORD"] = "sensitive"
+    app.config["MY_API_KEY"] = "sensitive"
+    app.config["VISIBLE_VALUE"] = "shown"
+    cli = FlaskGroup(create_app=lambda: app)
+
+    result = runner.invoke(cli, ["config"])
+    assert result.exit_code == 0
+    config = json.loads(result.output)
+    assert config["SECRET_KEY"] == "***"
+    assert config["CUSTOM_TOKEN"] == "***"
+    assert config["MY_PASSWORD"] == "***"
+    assert config["MY_API_KEY"] == "***"
+    assert config["VISIBLE_VALUE"] == "shown"
