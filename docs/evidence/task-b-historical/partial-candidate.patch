+@click.command("config", short_help="Show the config for the app.")
+@click.option(
+    "--key",
+    "-k",
+    help="Show only a single key instead of the full config.",
+)
+@with_appcontext
+def config_command(key: str | None) -> None:
+    """Show the application's configuration as JSON."""
+    import json
+
+    config = current_app.config
+    data = {}
+
+    for k, v in config.items():
+        if any(token in k.upper() for token in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            data[k] = "***"
+        else:
+            try:
+                json.dumps(v)
+                data[k] = v
+            except (TypeError, ValueError):
+                data[k] = str(v)
+
+    if key is not None:
+        if key in data:
+            click.echo(json.dumps({key: data[key]}, indent=2))
+        else:
+            click.echo(f"Error: Key '{key}' not found in configuration.", err=True)
+            raise click.Abort()
+    else:
+        click.echo(json.dumps(data, indent=2))
+
+
