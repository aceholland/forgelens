+def test_config_command(app, runner):
+    app.config.update(
+        SECRET_KEY="dev",
+        PASSWORD="hunter2",
+        API_TOKEN="abc",
+        PUBLIC_KEY="xyz",
+        NORMAL_VALUE="visible",
+    )
+
+    result = runner.invoke(FlaskGroup(create_app=lambda: app), ["config"])
+    assert result.exit_code == 0
+
+    data = json.loads(result.output)
+    assert data["SECRET_KEY"] == "***"
+    assert data["PASSWORD"] == "***"
+    assert data["API_TOKEN"] == "***"
+    assert data["PUBLIC_KEY"] == "***"
+    assert data["NORMAL_VALUE"] == "visible"
+
+
+def test_config_command_in_help(app, runner):
+    result = runner.invoke(FlaskGroup(create_app=lambda: app), ["--help"])
+    assert result.exit_code == 0
+    assert "config" in result.output
+
