+@click.command("config", short_help="Show the config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the loaded application's configuration as JSON.
+
+    Values for keys containing ``SECRET``, ``PASSWORD``, ``TOKEN``, or
+    ``KEY`` are masked as ``***``.
+    """
+    config = {}
+
+    for key, value in current_app.config.items():
+        if any(
+            marker in key.upper()
+            for marker in ("SECRET", "PASSWORD", "TOKEN", "KEY")
+        ):
+            config[key] = "***"
+        else:
+            config[key] = value
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True, default=str))
+
