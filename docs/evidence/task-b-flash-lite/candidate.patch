+@click.command("config", short_help="Show the app's configuration.")
+@with_appcontext
+def config_command() -> None:
+    """Show the loaded application configuration as JSON.
+
+    Values of any key containing SECRET, PASSWORD, TOKEN or KEY are masked as '***'.
+    """
+    import json
+
+    out = {}
+    for key, value in sorted(current_app.config.items()):
+        if any(token in key.upper() for token in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            out[key] = "***"
+        else:
+            try:
+                # Ensure value is JSON serializable, otherwise fall back to string representation
+                json.dumps(value)
+                out[key] = value
+            except (TypeError, ValueError):
+                out[key] = str(value)
+
+    click.echo(json.dumps(out, indent=2))
+
